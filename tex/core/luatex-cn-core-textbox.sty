    底色 .tl_set:N = \l__luatexcn_inverted_bg_color_tl,
    边框色 .tl_set:N = \l__luatexcn_inverted_border_color_tl,
    邊框色 .tl_set:N = \l__luatexcn_inverted_border_color_tl,
    边框宽 .tl_set:N = \l__luatexcn_inverted_border_width_tl,
    邊框寬 .tl_set:N = \l__luatexcn_inverted_border_width_tl,
    断口 .choice:,
    断口 / 直角 .code:n = { \tl_set:Nn \l__luatexcn_inverted_break_tl { square } },
    断口 / 八角 .code:n = { \tl_set:Nn \l__luatexcn_inverted_break_tl { octagon } },
    断口 / square .code:n = { \tl_set:Nn \l__luatexcn_inverted_break_tl { square } },
    断口 / octagon .code:n = { \tl_set:Nn \l__luatexcn_inverted_break_tl { octagon } },
