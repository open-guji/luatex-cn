    可断行 .bool_set:N = \l__luatexcn_inverted_inline_bool,
    可斷行 .bool_set:N = \l__luatexcn_inverted_inline_bool,
    % 其余 key 属于文本框（高度、填充、padding……）：回退整块实现
    unknown .code:n = { \bool_set_true:N \l__luatexcn_inverted_fallback_bool },
  }

% Color name / spec -> "r g b" (same conversion as \TextBox)
\cs_new_protected:Nn \__luatexcn_inverted_to_rgb:NN
  {
    \tl_set:No #1 { #1 }
    \cs_if_exist:cTF { color @ #1 }
      {
        \exp_args:NV \extractcolorspec #1 \l_tmpa_tl
        \exp_args:NNx \convertcolorspec \l_tmpa_tl { rgb } \l_tmpb_tl
        \tl_set:Nx #2 { \l_tmpb_tl }
      }
      { \tl_set_eq:NN #2 #1 }
    \tl_replace_all:Nnn #2 { , } { ~ }
  }

% #1 = shape (none / rect / octagon)
% #2 = textbox fallback options (旧整块实现的默认参数)
% #3 = user options
% #4 = content
\cs_new_protected:Nn \__luatexcn_inverted:nnnn
  {
    \group_begin:
    \tl_set:Nn \l__luatexcn_inverted_font_color_tl { white }
    \tl_set:Nn \l__luatexcn_inverted_bg_color_tl { 0.2~0.2~0.2 }
    \tl_clear:N \l__luatexcn_inverted_border_color_tl
    \tl_set:Nn \l__luatexcn_inverted_border_width_tl { 0.4pt }
    \tl_set:Nn \l__luatexcn_inverted_break_tl { square }
    \bool_set_true:N \l__luatexcn_inverted_inline_bool
    \bool_set_false:N \l__luatexcn_inverted_fallback_bool
    \keys_set:nn { luatexcn / inverted } { #3 }
    \bool_lazy_or:nnTF
      { \l__luatexcn_inverted_fallback_bool }
      { ! \l__luatexcn_inverted_inline_bool }
      {
        \group_end:
        \__luatexcn_textbox_resolve_cell_gw:N \l_tmpa_dim
        \__luatexcn_textbox_resolve_cell_gh:N \l_tmpb_dim
        \TextBox [ grid-width = \l_tmpa_dim , grid-height = \l_tmpb_dim , #2 , #3 ] { #4 }
      }
      {
        \__luatexcn_inverted_to_rgb:NN \l__luatexcn_inverted_font_color_tl \l__luatexcn_inverted_font_rgb_tl
        \__luatexcn_inverted_to_rgb:NN \l__luatexcn_inverted_bg_color_tl \l__luatexcn_inverted_bg_rgb_tl
        \__luatexcn_inverted_to_rgb:NN \l__luatexcn_inverted_border_color_tl \l__luatexcn_inverted_border_rgb_tl
        \lua_now:e
          {
            require('core.luatex-cn-constants').register_inverted(
              "#1",
              [=[\l__luatexcn_inverted_bg_rgb_tl]=],
              [=[\l__luatexcn_inverted_border_rgb_tl]=],
              [=[\luaescapestring{\l__luatexcn_inverted_border_width_tl}]=],
              "\l__luatexcn_inverted_break_tl"
            )
          }
        \setluatexattribute \cnverticalinvert { \g__luatexcn_invert_gid }
        % 字色：与 \TextBox 相同，排版时就把字色样式打到字形上（#187）
        \edef \l__luatexcn_inverted_style_id_tl
          {
            \lua_now:e
              {
                local ~ sr = require('util.luatex-cn-style-registry')
                tex.print(tostring(sr.push_content_style([=[\l__luatexcn_inverted_font_rgb_tl]=], nil, nil, nil)))
              }
          }
        \setluatexattribute \cnverticalstyle { \l__luatexcn_inverted_style_id_tl }
        #4
        \lua_now:n { require('util.luatex-cn-style-registry').pop() }
        \group_end:
      }
  }

% -- 反白：黑底白字，无边框 --
\NewDocumentCommand{\反白}{ O{} m }
  {
    \__luatexcn_inverted:nnnn { none }
      { background-color = {0.2~0.2~0.2}, font-color = white }
      { #1 } { #2 }
  }

% -- 墨围：矩形黑色边框 --
\NewDocumentCommand{\墨围}{ O{} m }
  {
    \__luatexcn_textbox_resolve_cell_gw:N \l_tmpa_dim
    \__luatexcn_textbox_resolve_cell_gh:N \l_tmpb_dim
    \TextBox[
      border-shape=rect,
      grid-width=\l_tmpa_dim,
      grid-height=\l_tmpb_dim,
      border-margin-x=0.05em,
      border-margin-y=0.1em,
      outer-margin=0.15em,
      #1
    ]{#2}
  }

