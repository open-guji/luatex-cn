    publisher-font-size .initial:n = 16pt,
    publisher-left .dim_set:N = \l__luatexcn_tcover_publisher_left_dim,
    publisher-left .initial:n = 20mm,
    publisher-top .dim_set:N = \l__luatexcn_tcover_publisher_top_dim,
