% --- \封面文字[left=, top=, font-size=, color=]{text} ------------------------
\dim_new:N \l__luatexcn_ctext_left_dim
\dim_new:N \l__luatexcn_ctext_top_dim
\dim_new:N \l__luatexcn_ctext_fs_dim
\tl_new:N \l__luatexcn_ctext_color_tl
\keys_define:nn { luatexcn / covertext }
  {
    left .dim_set:N = \l__luatexcn_ctext_left_dim,
    top .dim_set:N = \l__luatexcn_ctext_top_dim,
    font-size .dim_set:N = \l__luatexcn_ctext_fs_dim,
    color .tl_set:N = \l__luatexcn_ctext_color_tl,
    左距 .meta:n = { left = {#1} },
    上距 .meta:n = { top = {#1} },
    字号 .meta:n = { font-size = {#1} },
    字號 .meta:n = { font-size = {#1} },
    颜色 .meta:n = { color = {#1} },
    顏色 .meta:n = { color = {#1} },
  }

% 当前（逻辑）页宽：单页 / 对开均由引擎换算，悬浮框 x 以页面右边计
\cs_new:Npn \__luatexcn_tcover_page_width:
  {
    \lua_now:n
      {
        local~sp = require('core.luatex-cn-core-page').split ;
        local~w = _G.page.paper_width~or~0 ;
        if~sp.is_enabled()~and~sp.get_target_width()~>~0~then~
          w = sp.get_target_width() ;
        end ;
        tex.sprint((w~/~65536)~..~'pt') ;
      }
  }

\cs_new_protected:Npn \luatexcn_cover_text:nn #1 #2
  {
    \group_begin:
      \dim_set:Nn \l__luatexcn_ctext_left_dim { 20mm }
      \dim_set:Nn \l__luatexcn_ctext_top_dim { 20mm }
      \dim_set:Nn \l__luatexcn_ctext_fs_dim { 14pt }
      \tl_set:Nn \l__luatexcn_ctext_color_tl { 255, 255, 255 }
      \keys_set:nn { luatexcn / covertext } {#1}
      \dim_set:Nn \l__luatexcn_tcover_w_dim { 1.2 \l__luatexcn_ctext_fs_dim }
      \tl_set:Nx \l_tmpa_tl
        {
          [
            floating = true,
            x = \dim_eval:n
              { \l__luatexcn_tcover_pw_dim - \l__luatexcn_ctext_left_dim - \l__luatexcn_tcover_w_dim },
            y = \dim_use:N \l__luatexcn_ctext_top_dim,
            font-size = \dim_use:N \l__luatexcn_ctext_fs_dim,
            grid-height = \dim_use:N \l__luatexcn_ctext_fs_dim,
            grid-width = \dim_use:N \l__luatexcn_tcover_w_dim,
            height = \int_eval:n { \tl_count:n {#2} },
            column-align = center,
            font-color = { \l__luatexcn_ctext_color_tl },
          ]
        }
      \exp_after:wN \TextBox \l_tmpa_tl {#2}
    \group_end:
  }
\cs_generate_variant:Nn \luatexcn_cover_text:nn { eV }
\NewDocumentCommand \CoverText { O{} m }
  {
    \dim_set:Nn \l__luatexcn_tcover_pw_dim { \__luatexcn_tcover_page_width: }
    \luatexcn_cover_text:nn {#1} {#2}
  }

% --- 书名签 ------------------------------------------------------------------
% 单个悬浮盒：签底色 + 内框（border）+ 外缘细线（outer-border），
% 内外框之间的留白由 outer-border-sep 以签底色填充。
% 注意：不要拆成「底纸盒 + 书名盒」两个悬浮盒——悬浮盒的绘制次序不固定，书名可能被底纸盖住。
\cs_new_protected:Npn \__luatexcn_tcover_label:
  {
    % 字格宽：取书名与副题中较大字号的 1.3 倍
    \dim_set:Nn \l__luatexcn_tcover_gw_dim { 1.3 \l__luatexcn_tcover_title_fs_dim }
    % 列高：书名 + 副题（副题前空半个书名字）+ 上下各 0.2 字留白
    \dim_set:Nn \l__luatexcn_tcover_h_dim
      {
        \fp_eval:n { \tl_count:V \l__luatexcn_tcover_title_tl + 0.4 }
          \l__luatexcn_tcover_title_fs_dim
        \tl_if_empty:NF \l__luatexcn_tcover_subtitle_tl
          {
            + 0.5 \l__luatexcn_tcover_title_fs_dim
            + \tl_count:V \l__luatexcn_tcover_subtitle_tl \l__luatexcn_tcover_subtitle_fs_dim
          }
      }
    % 签总宽 = 字格宽 + 2 ×（内框距 2pt + 框线半宽 0.4pt + 留白 + 外线 0.6pt）
    \dim_set:Nn \l__luatexcn_tcover_w_dim
      { \l__luatexcn_tcover_gw_dim + 2 \l__luatexcn_tcover_label_pad_dim + 6pt }
    \tl_set:Nx \l_tmpa_tl
      {
        [
          floating = true,
          x = \dim_eval:n
            { \l__luatexcn_tcover_pw_dim - \l__luatexcn_tcover_label_left_dim - \l__luatexcn_tcover_w_dim },
          y = \dim_use:N \l__luatexcn_tcover_label_top_dim,
          font-size = \dim_use:N \l__luatexcn_tcover_title_fs_dim,
          grid-height = \dim_use:N \l__luatexcn_tcover_title_fs_dim,
          grid-width = \dim_use:N \l__luatexcn_tcover_gw_dim,
          height = \dim_use:N \l__luatexcn_tcover_h_dim,
          background-color = { \l__luatexcn_tcover_label_bg_tl },
          font-color = { \l__luatexcn_tcover_label_color_tl },
          border-color = { \l__luatexcn_tcover_label_color_tl },
          column-align = center,
          border-shape = rect,
          border-width = 0.8pt,
          border-margin = 2pt,
          outer-border = true,
          outer-border-thickness = 0.6pt,
          outer-border-sep = \dim_use:N \l__luatexcn_tcover_label_pad_dim,
        ]
      }
    \tl_if_empty:NTF \l__luatexcn_tcover_subtitle_tl
      { \exp_after:wN \TextBox \l_tmpa_tl { \l__luatexcn_tcover_title_tl } }
      {
        \tl_set:Nx \l_tmpb_tl
          {
            \exp_not:V \l__luatexcn_tcover_title_tl
            \exp_not:N \Style
              [ font-size = \dim_eval:n { 0.5 \l__luatexcn_tcover_title_fs_dim },
                grid-height = \dim_eval:n { 0.5 \l__luatexcn_tcover_title_fs_dim } ]
              { \exp_not:N \char"3000 \scan_stop: }
            \exp_not:N \Style
              [ font-size = \dim_use:N \l__luatexcn_tcover_subtitle_fs_dim,
                grid-height = \dim_use:N \l__luatexcn_tcover_subtitle_fs_dim ]
              { \exp_not:V \l__luatexcn_tcover_subtitle_tl }
          }
        \use:x { \exp_not:N \TextBox \exp_not:V \l_tmpa_tl { \exp_not:V \l_tmpb_tl } }
      }
  }

\NewDocumentCommand \ThreadBoundCover { O{} m }
  {
    \group_begin:
      \bool_set_false:N \l__luatexcn_tcover_author_left_set_bool
      \bool_set_false:N \l__luatexcn_tcover_author_top_set_bool
      \keys_set:nn { luatexcn / threadcover } {#1}
      \tl_set:Nn \l__luatexcn_tcover_title_tl {#2}
      \tl_set:Nx \l_tmpb_tl { \exp_not:N \begin{Cover} [ background-color = { \l__luatexcn_tcover_bg_tl } ] }
      \exp_last_unbraced:No \use:n \l_tmpb_tl
        \dim_set:Nn \l__luatexcn_tcover_pw_dim { \__luatexcn_tcover_page_width: }
        \__luatexcn_tcover_label:
        % 作者：默认紧贴书名签右侧，自签下缘向上留出作者字数高度对齐签底
        \tl_if_empty:NF \l__luatexcn_tcover_author_tl
          {
            \bool_if:NF \l__luatexcn_tcover_author_left_set_bool
              {
                \dim_set:Nn \l__luatexcn_tcover_author_left_dim
                  { \l__luatexcn_tcover_label_left_dim + \l__luatexcn_tcover_w_dim + 4mm }
              }
            \bool_if:NF \l__luatexcn_tcover_author_top_set_bool
              {
                \dim_set:Nn \l__luatexcn_tcover_author_top_dim
                  {
                    \l__luatexcn_tcover_label_top_dim + \l__luatexcn_tcover_h_dim + 20pt
                    - \tl_count:V \l__luatexcn_tcover_author_tl \l__luatexcn_tcover_author_fs_dim
                  }
                \dim_compare:nNnT \l__luatexcn_tcover_author_top_dim < \l__luatexcn_tcover_label_top_dim
                  { \dim_set_eq:NN \l__luatexcn_tcover_author_top_dim \l__luatexcn_tcover_label_top_dim }
              }
            \luatexcn_cover_text:eV
              {
                left = \dim_use:N \l__luatexcn_tcover_author_left_dim,
                top = \dim_use:N \l__luatexcn_tcover_author_top_dim,
                font-size = \dim_use:N \l__luatexcn_tcover_author_fs_dim,
                color = { \l__luatexcn_tcover_text_color_tl },
              }
              \l__luatexcn_tcover_author_tl
          }
        % 出版者：默认在页面下部（底边上方 20mm）
        \tl_if_empty:NF \l__luatexcn_tcover_publisher_tl
          {
            \dim_compare:nNnT \l__luatexcn_tcover_publisher_top_dim = \c_zero_dim
              {
                \dim_set:Nn \l__luatexcn_tcover_publisher_top_dim
                  {
                    \lua_now:n { tex.sprint(require('core.luatex-cn-core-page').get_dim_str('paper_height')) }
                    - 20mm
                    - \tl_count:V \l__luatexcn_tcover_publisher_tl \l__luatexcn_tcover_publisher_fs_dim
                  }
              }
            \luatexcn_cover_text:eV
              {
                left = \dim_use:N \l__luatexcn_tcover_publisher_left_dim,
                top = \dim_use:N \l__luatexcn_tcover_publisher_top_dim,
                font-size = \dim_use:N \l__luatexcn_tcover_publisher_fs_dim,
                color = { \l__luatexcn_tcover_text_color_tl },
              }
              \l__luatexcn_tcover_publisher_tl
          }
      \end{Cover}
    \group_end:
  }

