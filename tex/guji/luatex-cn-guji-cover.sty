    title-font-size .dim_set:N = \l__luatexcn_tcover_title_fs_dim,
    title-font-size .initial:n = 30pt,
    subtitle-font-size .dim_set:N = \l__luatexcn_tcover_subtitle_fs_dim,
    subtitle-font-size .initial:n = 18pt,
    label-left .dim_set:N = \l__luatexcn_tcover_label_left_dim,
    label-left .initial:n = 15mm,
    label-top .dim_set:N = \l__luatexcn_tcover_label_top_dim,
    label-top .initial:n = 15mm,
    label-padding .dim_set:N = \l__luatexcn_tcover_label_pad_dim,
    label-padding .initial:n = 7pt,
    label-background-color .tl_set:N = \l__luatexcn_tcover_label_bg_tl,
    label-background-color .initial:n = { 250, 248, 240 },
    label-color .tl_set:N = \l__luatexcn_tcover_label_color_tl,
    label-color .initial:n = { 0, 0, 0 },
