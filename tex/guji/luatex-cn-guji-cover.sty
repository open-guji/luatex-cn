    作者 .meta:n = { author = {#1} },
    作者字号 .meta:n = { author-font-size = {#1} },
    作者左距 .meta:n = { author-left = {#1} },
    作者上距 .meta:n = { author-top = {#1} },
    出版者 .meta:n = { publisher = {#1} },
    出版者字号 .meta:n = { publisher-font-size = {#1} },
    出版者左距 .meta:n = { publisher-left = {#1} },
    出版者上距 .meta:n = { publisher-top = {#1} },
    % 繁體
    副題 .meta:n = { subtitle = {#1} },
    書名字號 .meta:n = { title-font-size = {#1} },
    副題字號 .meta:n = { subtitle-font-size = {#1} },
    簽左距 .meta:n = { label-left = {#1} },
    簽上距 .meta:n = { label-top = {#1} },
    簽留白 .meta:n = { label-padding = {#1} },
    簽底色 .meta:n = { label-background-color = {#1} },
    簽字色 .meta:n = { label-color = {#1} },
